{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opentofu-mcp-server",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-09",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "mcp.opentofu.org",
      "custom_domain": true
    }
  ],
  "services": [
    {
      "binding": "REGISTRY_API",
      "service": "registry-ui-search"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OpenTofuMCP"]
    },
    {
      "tag": "v2",
      "deleted_classes": ["OpenTofuMCP"]
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "destinations": ["worker-logs"]
    },
    "traces": {
      "enabled": true,
      "destinations": ["worker-traces"]
    }
  }
}
